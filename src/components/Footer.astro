---
import siteData from '../data/site.json';
import { t } from '../i18n/ui.js';

interface Props {
  lang: 'cs' | 'en';
}

const { lang } = Astro.props;
const strings = t(lang);
const site = siteData[lang];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <hr class="rule" />
  <div class="container grid">
    <div>
      <div class="brand-name">{siteData.practiceName}</div>
      <p class="muted">{siteData.address}</p>
    </div>
    <div>
      <div class="col-title tick">{strings.footer.contact}</div>
      <p class="muted">
        <a href={`tel:${siteData.phone}`}>{siteData.phone}</a><br />
        <a href={`mailto:${siteData.email}`}>{siteData.email}</a>
      </p>
    </div>
    <div>
      <div class="col-title tick">{strings.footer.hours}</div>
      <p class="muted" style="white-space:pre-line">{site.hours}</p>
    </div>
  </div>
  <div class="container">
    <p class="fine">© {year} {siteData.practiceName}. {strings.footer.rights}</p>
  </div>
</footer>

<style>
  .site-footer { padding-top: 3rem; padding-bottom: 2.5rem; }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 2rem;
    padding: 2.5rem 1.5rem;
  }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; gap: 1.5rem; padding-bottom: 1rem; }
  }
  .brand-name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }
  .col-title { margin-bottom: 0.5rem; }
  .muted { color: var(--slate); font-size: 0.95rem; }
  .fine { color: var(--slate); font-size: 0.8rem; margin: 0; }
</style>
